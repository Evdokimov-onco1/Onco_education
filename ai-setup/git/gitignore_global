# Глобальный gitignore: применяется ко всем репозиториям на этой машине.
# Подключается через  git config --global core.excludesfile ~/ai-setup/git/gitignore_global
#
# Смысл: файлы остаются на диске и работать с ними можно, но git их не видит
# и случайно закоммитить их нельзя.

# --- сырые данные: никогда не в git ---
data/raw/
data/private/
выгрузка*
выгрузки/
ЭМК*
эмк*

# --- форматы, в которых обычно приезжают выгрузки и документы пациентов ---
*.xlsx
*.xls
*.csv
*.dbf
*.mdb

# исключения: если таблица заведомо обезличена, положить её сюда
!data/public/*.csv
!data/public/*.xlsx

# --- сканы и снимки ---
*.dcm
скан*
Скан*

# --- служебное ---
.DS_Store
Thumbs.db
.env
.env.*
*.log
__pycache__/
.venv/
venv/
node_modules/
.ipynb_checkpoints/
out/tmp/
