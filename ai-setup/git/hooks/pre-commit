#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Проверка коммита на персональные данные пациентов.

Не запрещает, а предупреждает и спрашивает. Если терминал доступен — задаёт
вопрос; если запущено агентом или скриптом — останавливает коммит с объяснением,
чтобы вопрос дошёл до человека, а не потерялся в логе.

Признаки делятся на два класса, чтобы проверка не срабатывала попусту:

  жёсткие  — СНИЛС, полис, паспорт, телефон. В учебных материалах их не бывает,
             поэтому останавливают поодиночке.
  мягкие   — ФИО, дата рождения, адрес, номер истории болезни. Поодиночке молчат:
             фамилия врача в методичке — не персональные данные пациента.
             Сигналом становится сочетание двух разных мягких признаков в одном
             файле или список из многих ФИО.

Настройка: ~/ai-setup/git/pdn.conf, в проекте — .ai/pdn.conf
Пропустить осознанно: PDN_OK=1 git commit ...
"""
import os
import re
import subprocess
import sys

ЖЁСТКИЕ = [
    ("СНИЛС",      re.compile(r"\b\d{3}-\d{3}-\d{3}[ -]\d{2}\b")),
    ("полис ОМС",  re.compile(r"\b\d{16}\b")),
    ("паспорт",    re.compile(r"\b\d{4}\s?\d{6}\b")),
    ("телефон",    re.compile(r"\+7\s?\(?\d{3}\)?[\s-]?\d{3}[\s-]?\d{2}[\s-]?\d{2}")),
]

МЯГКИЕ = [
    ("ФИО",           re.compile(r"\b[А-ЯЁ][а-яё]{2,}\s+[А-ЯЁ]\.\s?[А-ЯЁ]\.")),
    ("ФИО полное",    re.compile(r"\b[А-ЯЁ][а-яё]{2,}\s+[А-ЯЁ][а-яё]{2,}\s+"
                                 r"[А-ЯЁ][а-яё]+(?:ович|евич|ьич|овна|евна|ична|инична)\b")),
    ("дата рождения", re.compile(r"(?:д\.\s?р\.|дата\s+рождения|род\.\s?\d)", re.IGNORECASE)),
    ("адрес",         re.compile(r"\b(?:ул\.|улица|просп\.|проспект|д\.\s?\d+.{0,12}кв\.\s?\d+)",
                                 re.IGNORECASE)),
    ("номер карты",   re.compile(r"(?:истори[ияи]\s+болезни|амб(?:ул)?\.?\s*карт[аы]|"
                                 r"мед\.?\s*карт[аы])\s*№?\s*\d+", re.IGNORECASE)),
]

РИСКОВЫЕ_РАСШИРЕНИЯ = {".xlsx", ".xls", ".csv", ".dbf", ".mdb", ".dcm"}
РИСКОВЫЕ_ИМЕНА = re.compile(r"выгрузк|эмк|пациент|больн|диспансер", re.IGNORECASE)


def настройки():
    """Читает pdn.conf: сначала глобальный, потом проектный поверх него."""
    знач = {"режим": "обычный", "порог-фио": 10, "не-проверять": []}
    пути = [
        os.path.expanduser("~/ai-setup/git/pdn.conf"),
        os.path.join(os.getcwd(), ".ai", "pdn.conf"),
    ]
    for путь in пути:
        try:
            with open(путь, encoding="utf-8") as f:
                for строка in f:
                    строка = строка.split("#", 1)[0].strip()
                    if "=" not in строка:
                        continue
                    ключ, _, значение = строка.partition("=")
                    ключ, значение = ключ.strip(), значение.strip()
                    if ключ == "режим":
                        знач["режим"] = значение
                    elif ключ == "порог-фио":
                        try:
                            знач["порог-фио"] = int(значение)
                        except ValueError:
                            pass
                    elif ключ == "не-проверять" and ":" in значение:
                        путь_, _, правило = значение.partition(":")
                        знач["не-проверять"].append((путь_.strip(), правило.strip()))
        except OSError:
            pass
    return знач


def исключения():
    имена = set()
    for путь in (os.path.expanduser("~/ai-setup/git/pdn-allow.txt"),
                 os.path.join(os.getcwd(), ".ai", "pdn-allow.txt")):
        try:
            with open(путь, encoding="utf-8") as f:
                for строка in f:
                    строка = строка.strip()
                    if строка and not строка.startswith("#"):
                        имена.add(строка)
        except OSError:
            pass
    return имена


def отключено(путь, правило, список):
    return any(путь.startswith(п) and (пр == правило or пр == "все")
               for п, пр in список)


def маска(текст):
    """Само значение в терминал и в лог агента попадать не должно."""
    текст = текст.strip()
    return "…" if len(текст) <= 4 else текст[:2] + "…" + текст[-2:]


def файлы_в_коммите():
    # -z обязателен: без него git экранирует кириллические имена в вид
    # "\320\277\320\260..." и такой путь потом не открывается.
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACM"],
        capture_output=True, check=False,
    )
    пути = out.stdout.decode("utf-8", errors="replace").split("\0")
    return [п for п in пути if п.strip()]


def содержимое(путь):
    out = subprocess.run(["git", "show", ":" + путь], capture_output=True, check=False)
    if out.returncode != 0:
        return None
    try:
        return out.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None          # двоичный файл — содержимое не проверяем


def своё(путь):
    """Файлы самой проверки: в них слова-признаки написаны буквально.

    Хук ловил бы сам себя на строках вида "дата рождения" и "ул." в шаблонах,
    а pdn-allow.txt — на фамилиях коллег, которые в нём и должны лежать.
    """
    имя = os.path.basename(путь)
    if имя in ("pdn.conf", "pdn-allow.txt"):
        return True
    try:
        return os.path.samefile(путь, os.path.abspath(__file__))
    except OSError:
        return False


def проверить_файл(путь, конф, разрешено):
    """Возвращает список находок по одному файлу."""
    if своё(путь):
        return []
    находки = []
    имя = os.path.basename(путь)
    расширение = os.path.splitext(имя)[1].lower()

    if расширение in РИСКОВЫЕ_РАСШИРЕНИЯ and not отключено(путь, "формат выгрузки", конф["не-проверять"]):
        находки.append((путь, 0, "формат выгрузки", расширение))
    elif РИСКОВЫЕ_ИМЕНА.search(имя) and not отключено(путь, "имя файла", конф["не-проверять"]):
        находки.append((путь, 0, "имя файла", имя))

    текст = содержимое(путь)
    if текст is None:
        return находки

    жёсткие_находки = []
    мягкие_находки = []
    мягкие_типы = set()
    уникальные_фио = set()

    for номер, строка in enumerate(текст.splitlines(), 1):
        for тип, шаблон in ЖЁСТКИЕ:
            if отключено(путь, тип, конф["не-проверять"]):
                continue
            совпадение = шаблон.search(строка)
            if совпадение and совпадение.group(0).strip() not in разрешено:
                жёсткие_находки.append((путь, номер, тип, маска(совпадение.group(0))))

        for тип, шаблон in МЯГКИЕ:
            if отключено(путь, тип, конф["не-проверять"]):
                continue
            совпадение = шаблон.search(строка)
            if not совпадение:
                continue
            значение = совпадение.group(0).strip()
            if значение in разрешено:
                continue
            if тип.startswith("ФИО"):
                уникальные_фио.add(значение)
            мягкие_типы.add(тип)
            мягкие_находки.append((путь, номер, тип, маска(значение)))

    находки.extend(жёсткие_находки)

    # Мягкие признаки поодиночке не считаются: фамилия в методичке — не выгрузка.
    много_фио = len(уникальные_фио) >= конф["порог-фио"]
    сочетание = len(мягкие_типы) >= 2
    if конф["режим"] == "строгий" or сочетание or много_фио:
        находки.extend(мягкие_находки)

    return находки


def main():
    if os.environ.get("PDN_OK") == "1":
        return 0

    конф = настройки()
    if конф["режим"] == "выкл":
        return 0

    разрешено = исключения()
    находки = []
    for путь in файлы_в_коммите():
        находки.extend(проверить_файл(путь, конф, разрешено))

    if not находки:
        return 0

    print("", file=sys.stderr)
    print("  Похоже на персональные данные в том, что вы коммитите:", file=sys.stderr)
    print("", file=sys.stderr)
    for путь, номер, тип, фрагмент in находки[:20]:
        место = f"{путь}:{номер}" if номер else путь
        print(f"    {место}  —  {тип}: {фрагмент}", file=sys.stderr)
    if len(находки) > 20:
        print(f"    … и ещё {len(находки) - 20}", file=sys.stderr)

    print("", file=sys.stderr)
    print("  История git хранится вечно: удалить файл следующим коммитом недостаточно.",
          file=sys.stderr)
    print("", file=sys.stderr)
    print("  Чтобы про это больше не спрашивали, впишите в .ai/pdn.conf:", file=sys.stderr)
    for строка in подсказки(находки):
        print(f"    {строка}", file=sys.stderr)
    print("", file=sys.stderr)

    try:
        with open("/dev/tty") as tty:
            print("  Коммитить всё равно? [y/N] ", end="", file=sys.stderr, flush=True)
            ответ = tty.readline().strip().lower()
        if ответ in ("y", "yes", "д", "да"):
            print("  Хорошо, коммичу.", file=sys.stderr)
            return 0
        print("  Отменено. Файлы на диске не тронуты.", file=sys.stderr)
        print("  Убрать из коммита:  git restore --staged <файл>", file=sys.stderr)
        return 1
    except OSError:
        pass

    print("  Коммит остановлен, потому что спросить некого.", file=sys.stderr)
    print("  Файлы на диске не тронуты. Дальше на выбор:", file=sys.stderr)
    print("", file=sys.stderr)
    print("    убрать из коммита   git restore --staged <файл>", file=sys.stderr)
    print("    это не ПДн          строка выше в .ai/pdn.conf", file=sys.stderr)
    print("    всё равно коммитить PDN_OK=1 git commit ...", file=sys.stderr)
    print("", file=sys.stderr)
    return 1


def подсказки(находки):
    """Готовые строки для .ai/pdn.conf — по одной на пару путь+правило."""
    пары = []
    for путь, _, тип, _ in находки:
        пара = (путь, тип)
        if пара not in пары:
            пары.append(пара)
    return [f"не-проверять = {путь}: {тип}" for путь, тип in пары[:6]]


if __name__ == "__main__":
    sys.exit(main())
